diff --git a/apps/server/src/integrations/export/docx-export.service.ts b/apps/server/src/integrations/export/docx-export.service.ts
new file mode 100644
index 0000000..2da3777
--- /dev/null
+++ b/apps/server/src/integrations/export/docx-export.service.ts
@@ -0,0 +1,348 @@
+import { Injectable, Logger } from '@nestjs/common';
+import { InjectKysely } from 'nestjs-kysely';
+import { KyselyDB } from '@docmost/db/types/kysely.types';
+import { Page } from '@docmost/db/types/entity.types';
+import { pageNodeToDocxBuffer } from '@docmost/editor-ext';
+import { jsonToNode } from '../../collaboration/collaboration.util';
+import { getProsemirrorContent } from '../../common/helpers/prosemirror/utils';
+import { StorageService } from '../storage/storage.service';
+import { EnvironmentService } from '../environment/environment.service';
+import { Node } from '@tiptap/pm/model';
+import * as path from 'path';
+import * as JSZip from 'jszip';
+import { Resvg } from '@resvg/resvg-js';
+import { getSafePageTitle } from './utils';
+
+// Matches "/api/files/{id}/{name}" and "/files/{id}/{name}", with or without
+// a host prefix.
+const ATTACHMENT_URL_REGEX =
+  /\/files\/([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\//;
+
+const UUID_REGEX =
+  /^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
+
+const IMAGE_NODE_TYPES = ['image', 'drawio', 'excalidraw'];
+
+// Nodes whose file cannot live inside a .docx; rendered as a hyperlink instead.
+const LINK_NODE_TYPES = [
+  'video',
+  'audio',
+  'pdf',
+  'attachment',
+  'embed',
+  'youtube',
+];
+
+// Word cannot embed SVG, so diagram attachments are rasterized to PNG.
+// Rendered wider than the 600px used for layout so print quality holds up.
+const SVG_RASTER_WIDTH = 1400;
+const SVG_FILE_REGEX = /\.svg$/i;
+
+type AttachmentFile = {
+  path: string;
+  buffer: Buffer;
+};
+
+// Mermaid is a browser library, so diagrams are rendered to SVG by the client
+// and sent along with the export request.
+export type MermaidDiagram = {
+  source: string;
+  svg: string;
+};
+
+@Injectable()
+export class DocxExportService {
+  private readonly logger = new Logger(DocxExportService.name);
+
+  constructor(
+    @InjectKysely() private readonly db: KyselyDB,
+    private readonly storageService: StorageService,
+    private readonly environmentService: EnvironmentService,
+  ) {}
+
+  async exportPage(
+    page: Page,
+    mermaidDiagrams: MermaidDiagram[] = [],
+  ): Promise<Buffer> {
+    const doc = jsonToNode(
+      this.prependPageTitle(getProsemirrorContent(page.content), page.title),
+    );
+    const attachmentFiles = await this.prepareAttachmentNodes(doc);
+    const mermaidImages = this.attachMermaidImages(doc, mermaidDiagrams);
+
+    const getImageBuffer = async (src: string): Promise<Uint8Array> => {
+      const diagram = mermaidImages.get(src);
+      if (diagram) return diagram;
+
+      const attachmentId = this.extractAttachmentId(src);
+      if (!attachmentId) {
+        this.logger.warn(`DOCX export: unsupported image source ${src}`);
+        throw new Error(`Unsupported image source: ${src}`);
+      }
+
+      const attachment = await this.db
+        .selectFrom('attachments')
+        .select(['filePath', 'fileName'])
+        .where('id', '=', attachmentId)
+        .executeTakeFirst();
+
+      if (!attachment) {
+        this.logger.warn(`DOCX export: attachment not found ${attachmentId}`);
+        throw new Error(`Attachment not found: ${attachmentId}`);
+      }
+
+      const buffer = await this.storageService.read(attachment.filePath);
+
+      if (this.isSvgAttachment(attachment.fileName, buffer)) {
+        return this.rasterizeSvg(buffer, attachmentId);
+      }
+
+      return new Uint8Array(buffer);
+    };
+
+    const docxBuffer = await pageNodeToDocxBuffer(doc, getImageBuffer);
+
+    // Attachments travel next to the .docx so the hyperlinks inside the
+    // document keep working offline, without calling back into Docmost.
+    const zip = new JSZip();
+    zip.file(`${getSafePageTitle(page.title)}.docx`, docxBuffer);
+    attachmentFiles.forEach((file) => zip.file(file.path, file.buffer));
+
+    return zip.generateAsync({ type: 'nodebuffer' });
+  }
+
+  // The page title lives in its own column instead of the document body, so it
+  // has to be prepended as a heading to survive the export.
+  private prependPageTitle(prosemirrorJson: any, title: string) {
+    if (!title) return prosemirrorJson;
+
+    return {
+      ...prosemirrorJson,
+      content: [
+        {
+          type: 'heading',
+          attrs: { level: 1 },
+          content: [{ type: 'text', text: title }],
+        },
+        ...(prosemirrorJson.content ?? []),
+      ],
+    };
+  }
+
+  private extractAttachmentId(src: string): string | null {
+    if (!src) return null;
+    const match = ATTACHMENT_URL_REGEX.exec(src);
+    if (match) return match[1];
+    return UUID_REGEX.test(src) ? src : null;
+  }
+
+  // Word cannot embed SVG, so the client rendered diagrams are rasterized and
+  // swapped in for their code block. A diagram that fails to rasterize keeps
+  // its source text in the export.
+  private attachMermaidImages(
+    doc: Node,
+    diagrams: MermaidDiagram[],
+  ): Map<string, Uint8Array> {
+    const images = new Map<string, Uint8Array>();
+    if (diagrams.length === 0) return images;
+
+    const svgBySource = new Map<string, string>();
+    diagrams.forEach((diagram) => {
+      if (
+        typeof diagram?.source === 'string' &&
+        typeof diagram?.svg === 'string'
+      ) {
+        svgBySource.set(diagram.source, diagram.svg);
+      }
+    });
+    if (svgBySource.size === 0) return images;
+
+    doc.descendants((node: Node) => {
+      if (node.type.name !== 'codeBlock') return;
+      if (node.attrs?.language !== 'mermaid') return;
+
+      const svg = svgBySource.get(node.textContent);
+      if (!svg) return;
+
+      const src = `mermaid-diagram-${images.size + 1}.png`;
+      try {
+        images.set(src, this.rasterizeSvg(Buffer.from(svg, 'utf8'), src));
+        Object.assign(node.attrs, { mermaidImageSrc: src });
+      } catch (err) {
+        this.logger.warn(`DOCX export: failed to render mermaid diagram`, err);
+      }
+    });
+
+    return images;
+  }
+
+  // Word does not resolve hyperlink targets that contain percent-encoded or
+  // non-ASCII characters, so the packed copy gets an ASCII file name. The
+  // original name stays as the visible link text, and the attachment id in
+  // the folder path keeps the packed name unambiguous.
+  private packedFileName(attachmentId: string, fileName: string): string {
+    const extension = path.extname(fileName ?? '');
+    const safeExtension = extension.replace(/[^A-Za-z0-9.]+/g, '');
+    const safeBaseName = path
+      .basename(fileName ?? '', extension)
+      .replace(/[^A-Za-z0-9]+/g, '-')
+      .replace(/^-+|-+$/g, '')
+      .slice(0, 64);
+
+    return `${safeBaseName || attachmentId.slice(0, 8)}${safeExtension}`;
+  }
+
+  // Word can neither embed SVG nor any non-image file (video, audio, PDF,
+  // attachments), so attachment-backed nodes are rewritten before export:
+  //   - image/drawio/excalidraw keep a src the serializer reads as an image
+  //     (rasterized SVG diagrams are advertised as .png)
+  //   - every other file node links to the copy packed next to the .docx,
+  //     falling back to an absolute URL when the file cannot be read
+  private async prepareAttachmentNodes(doc: Node): Promise<AttachmentFile[]> {
+    const images: { node: Node; attachmentId: string }[] = [];
+    const links: {
+      node: Node;
+      attachmentId: string | null;
+      href: string | null;
+    }[] = [];
+
+    doc.descendants((node: Node) => {
+      const nodeType = node.type.name;
+
+      if (IMAGE_NODE_TYPES.includes(nodeType)) {
+        const attachmentId = this.resolveAttachmentId(node);
+        if (attachmentId) images.push({ node, attachmentId });
+        return;
+      }
+
+      if (LINK_NODE_TYPES.includes(nodeType)) {
+        links.push({
+          node,
+          attachmentId: this.resolveAttachmentId(node),
+          href: this.absoluteUrl(node.attrs?.src || node.attrs?.url || ''),
+        });
+      }
+    });
+
+    if (images.length === 0 && links.length === 0) return [];
+
+    const ids = new Set<string>();
+    images.forEach((item) => ids.add(item.attachmentId));
+    links.forEach((item) => {
+      if (item.attachmentId) ids.add(item.attachmentId);
+    });
+
+    const attachmentIds = [...ids];
+    const attachments = attachmentIds.length
+      ? await this.db
+          .selectFrom('attachments')
+          .select(['id', 'fileName', 'filePath'])
+          .where('id', 'in', attachmentIds)
+          .execute()
+      : [];
+    const attachmentById = new Map(
+      attachments.map((attachment) => [attachment.id, attachment]),
+    );
+
+    for (const { node, attachmentId } of images) {
+      const fileName = attachmentById.get(attachmentId)?.fileName;
+      if (!fileName) continue;
+      // The serializer picks the image type from the src file extension.
+      const exportName = SVG_FILE_REGEX.test(fileName)
+        ? fileName.replace(SVG_FILE_REGEX, '.png')
+        : fileName;
+      Object.assign(node.attrs, {
+        src: `/api/files/${attachmentId}/${exportName}`,
+      });
+    }
+
+    const files = new Map<string, AttachmentFile>();
+
+    for (const { node, attachmentId, href } of links) {
+      const attachment = attachmentId
+        ? attachmentById.get(attachmentId)
+        : undefined;
+
+      if (attachment) {
+        try {
+          const buffer = await this.storageService.read(attachment.filePath);
+          const packedName = this.packedFileName(
+            attachment.id,
+            attachment.fileName,
+          );
+          files.set(attachment.id, {
+            path: `files/${attachment.id}/${packedName}`,
+            buffer,
+          });
+          // hrefLabel keeps the original file name as the visible link text.
+          // The relative target resolves against the .docx, which sits next
+          // to the files/ folder in the exported zip.
+          Object.assign(node.attrs, {
+            href: `files/${attachment.id}/${packedName}`,
+            hrefLabel: attachment.fileName,
+          });
+          continue;
+        } catch (err) {
+          this.logger.warn(
+            `DOCX export: failed to read attachment ${attachment.id}`,
+            err,
+          );
+        }
+      }
+
+      // Nothing packed for this node: keep the original URL as the target.
+      if (href) {
+        Object.assign(node.attrs, { href, hrefLabel: attachment?.fileName });
+      }
+    }
+
+    return [...files.values()];
+  }
+
+  private resolveAttachmentId(node: Node): string | null {
+    for (const value of [
+      node.attrs?.attachmentId,
+      node.attrs?.src,
+      node.attrs?.url,
+    ]) {
+      if (typeof value !== 'string') continue;
+      const attachmentId = this.extractAttachmentId(value);
+      if (attachmentId) return attachmentId;
+    }
+    return null;
+  }
+
+  // Relative Docmost file URLs are turned into absolute ones so Word can open
+  // them from the exported document.
+  private absoluteUrl(value: string): string | null {
+    if (typeof value !== 'string' || value.length === 0) return null;
+    if (/^https?:\/\//i.test(value)) return value;
+    if (value.startsWith('/')) {
+      return `${this.environmentService.getAppUrl()}${value}`;
+    }
+    return null;
+  }
+
+  // drawio/excalidraw attachments are SVG; the file name is the cheap check,
+  // with a content sniff as a fallback.
+  private isSvgAttachment(fileName: string, buffer: Buffer): boolean {
+    if (SVG_FILE_REGEX.test(fileName ?? '')) return true;
+    return buffer.subarray(0, 1024).includes('<svg');
+  }
+
+  // Word cannot embed SVG, so diagram attachments are rasterized to PNG.
+  private rasterizeSvg(buffer: Buffer, attachmentId: string): Uint8Array {
+    try {
+      const resvg = new Resvg(buffer.toString('utf8'), {
+        fitTo: { mode: 'width', value: SVG_RASTER_WIDTH },
+      });
+      return new Uint8Array(resvg.render().asPng());
+    } catch (err) {
+      this.logger.warn(
+        `DOCX export: failed to rasterize SVG ${attachmentId}`,
+        err,
+      );
+      throw err;
+    }
+  }
+}
