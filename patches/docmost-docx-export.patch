diff --git a/apps/client/src/features/page/services/mermaid-export.ts b/apps/client/src/features/page/services/mermaid-export.ts
new file mode 100644
index 0000000..0e80c5c
--- /dev/null
+++ b/apps/client/src/features/page/services/mermaid-export.ts
@@ -0,0 +1,101 @@
+import mermaid from "mermaid";
+import { getPageById } from "./page-service";
+
+export interface MermaidDiagram {
+  source: string;
+  svg: string;
+}
+
+// The server rasterizes these SVGs, so they must survive a non-browser
+// renderer: no <foreignObject> labels and a font stack the container also has.
+const EXPORT_CONFIG = {
+  startOnLoad: false,
+  suppressErrorRendering: true,
+  htmlLabels: false,
+  theme: "default" as const,
+  fontFamily:
+    '"WenQuanYi Micro Hei", "Microsoft YaHei", "DejaVu Sans", sans-serif',
+};
+
+// The export travels in a JSON request body (1 MB by default), so diagrams
+// past this budget stay code blocks instead of breaking the whole export.
+const MAX_TOTAL_SVG_LENGTH = 400_000;
+
+interface ProseMirrorNode {
+  type?: string;
+  attrs?: { language?: string };
+  text?: string;
+  content?: ProseMirrorNode[];
+}
+
+// The page API returns the prosemirror document as JSON, but a serialized
+// string is accepted as well.
+function mermaidSources(content: unknown): string[] {
+  let doc: ProseMirrorNode;
+  if (typeof content === "string") {
+    try {
+      doc = JSON.parse(content);
+    } catch {
+      return [];
+    }
+  } else if (content && typeof content === "object") {
+    doc = content as ProseMirrorNode;
+  } else {
+    return [];
+  }
+
+  const sources: string[] = [];
+  const walk = (node: ProseMirrorNode) => {
+    if (node.type === "codeBlock") {
+      if (node.attrs?.language !== "mermaid") return;
+      const source = (node.content ?? [])
+        .map((child) => child.text ?? "")
+        .join("");
+      if (source.trim().length > 0) sources.push(source);
+      return;
+    }
+    node.content?.forEach(walk);
+  };
+
+  walk(doc);
+  return sources;
+}
+
+/**
+ * Renders the page's mermaid diagrams to SVG so the Word export can embed them
+ * as images. Diagrams that fail to render are left out and are exported as
+ * code blocks instead.
+ */
+export async function renderPageMermaidDiagrams(
+  pageId: string,
+): Promise<MermaidDiagram[]> {
+  const page = await getPageById({ pageId });
+  const sources = [...new Set(mermaidSources(page?.content))];
+  if (sources.length === 0) return [];
+
+  const previousConfig = mermaid.mermaidAPI.getSiteConfig();
+  mermaid.initialize(EXPORT_CONFIG);
+
+  try {
+    const diagrams: MermaidDiagram[] = [];
+    let totalLength = 0;
+
+    for (const source of sources) {
+      try {
+        const { svg } = await mermaid.render(
+          `mermaid-export-${diagrams.length}`,
+          source,
+        );
+        if (totalLength + svg.length > MAX_TOTAL_SVG_LENGTH) break;
+        totalLength += svg.length;
+        diagrams.push({ source, svg });
+      } catch {
+        // Invalid diagram: keep it as a code block in the export.
+      }
+    }
+
+    return diagrams;
+  } finally {
+    mermaid.initialize(previousConfig);
+  }
+}
